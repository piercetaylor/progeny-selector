# Runtime configuration (twelve-factor). All variables are optional; src/progeny_selector/config.py
# is the only module that reads them. No secrets exist: the tool processes local files.

# Refuse genotype uploads larger than this in the UI (MB).
PROGENY_SELECTOR_MAX_UPLOAD_MB=500

# Skip the pairwise-IBS duplicate check above this many progeny (O(n^2) on a marker subsample).
PROGENY_SELECTOR_MAX_SAMPLES_DUPLICATE_CHECK=2000

# UI defaults, overridable per session and by criteria.yaml.
PROGENY_SELECTOR_DEFAULT_FLANK_WINDOW_CM=5
PROGENY_SELECTOR_DEFAULT_MAX_MARKER_COVERAGE_CM=10

# Optional directory the Load screen lists for quick loading when running locally.
# PROGENY_SELECTOR_DATA_DIR=/path/to/genotype/files

PROGENY_SELECTOR_LOG_LEVEL=INFO
